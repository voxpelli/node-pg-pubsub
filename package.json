{
  "name": "pg-pubsub",
  "version": "0.8.1",
  "description": "A Publish/Subscribe implementation on top of PostgreSQL NOTIFY/LISTEN",
  "homepage": "http://github.com/voxpelli/node-pg-pubsub",
  "repository": {
    "type": "git",
    "url": "git://github.com/voxpelli/node-pg-pubsub.git"
  },
  "author": {
    "name": "Pelle Wessman",
    "email": "pelle@kodfabrik.se",
    "url": "http://kodfabrik.se/"
  },
  "license": "MIT",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0",
    "typescript": ">=5.8"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.d.ts.map"
  ],
  "scripts": {
    "build:0": "run-s clean",
    "build:1-declaration": "tsc -p declaration.tsconfig.json",
    "build:2-add-ignores": "ts-ignore-import '**/*.d.ts'",
    "build": "run-s build:*",
    "check:1:installed-check": "installed-check -i tstyche",
    "check:1:knip": "knip",
    "check:1:lint": "eslint",
    "check:1:tsc": "tsc",
    "check:1:type-coverage": "type-coverage --detail --strict --at-least 98 --ignore-files 'test/**/*'",
    "check:2": "run-s build && tstyche --reporters dot,summary && run-s clean",
    "check": "run-s clean && run-p check:1:* && run-s check:2",
    "clean:declarations": "rm -rf $(find . -maxdepth 2 -type f -name '*.d.ts*')",
    "clean": "run-p clean:*",
    "prepublishOnly": "run-s build",
    "test:node": "c8 --reporter=lcov --reporter text --skip-full node --test --test-reporter dot test/integration/*.spec.js",
    "test:tstyche": "run-s build && tstyche --target \"$(jq -r '.engines.typescript' package.json)\" --reporters dot,summary && run-s clean",
    "test-ci": "run-s test:*",
    "test": "run-s check test:*",
    "husky-enable": "husky",
    "husky-disable": "git config --unset core.hooksPath"
  },
  "dependencies": {
    "pg": "^8.7.3",
    "pg-format": "^1.0.2",
    "pony-cause": "^2.1.10",
    "promised-retry": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^18.18.0",
    "@types/pg": "^8.6.6",
    "@types/pg-format": "^1.0.2",
    "@voxpelli/eslint-config": "^23.0.0",
    "@voxpelli/tsconfig": "^16.1.0",
    "c8": "^10.1.3",
    "dotenv": "^16.0.3",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "installed-check": "^9.3.0",
    "knip": "^5.85.0",
    "npm-run-all2": "^7.0.2",
    "ts-ignore-import": "^4.0.1",
    "tstyche": "^6.2.0",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3"
  }
}
